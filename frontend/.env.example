# HoloMed Frontend — Environment Variable Reference
# Copy this to .env.development and fill in values.
# NEVER put backend secrets (JWT_SECRET, DB passwords, etc.) in VITE_* variables.

# Backend API base URL. Leave empty when using the Vite dev proxy (recommended).
# Production (GitHub Pages build, set in .github/workflows/deploy-pages.yml):
#   VITE_API_BASE_URL=https://api.shadowless.app
VITE_API_BASE_URL=

# OHIF viewer URL (served by FastAPI). Optional: when unset it is <VITE_API_BASE_URL>/ohif/,
# i.e. /ohif/ through the Vite proxy in development and the API origin in production.
# VITE_OHIF_URL=/ohif/
