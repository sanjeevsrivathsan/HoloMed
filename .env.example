# HoloMed backend — environment variable reference (NO real values).
# Copy to `.env` in the repository root (git-ignored) for local development,
# or set these as server secrets in the deployment environment.
# Never commit real values. Frontend variables are in frontend/.env.example.
# Optional variables are commented out; their defaults are shown.
#
# PRIMARY (development/demo) deployment: local GPU hosting.
#   VISION_PROVIDER=local
#   TEXT_AI_PROVIDER=ollama
# Local mode needs no cloud credentials, no VISION_CLOUD_* values and no internet access.
# Modal (VISION_PROVIDER=cloud) and OmniRoute (TEXT_AI_PROVIDER=omniroute) are OPTIONAL.

# ── Core ─────────────────────────────────────────────────────────────────────
# Required. Long random string (server secret).
JWT_SECRET=
# JWT_EXPIRE_MINUTES=
# HOLUMED_DB_PATH=./data/holomed.db
# DATABASE_URL=sqlite:///./data/holomed.db
# CORS_ORIGINS=http://localhost:5173

# Deployment environment: development (default) | production.
# production makes the session cookie Secure by default.
# HOLOMED_ENV=development
# Session cookie transport. Local HTTP development needs Secure=false.
# SESSION_COOKIE_SECURE=false
# lax (frontend + API on the same site) | strict | none (cross-site; forces Secure)
# SESSION_COOKIE_SAMESITE=lax

# ── Google Sign-In (optional; OIDC authorization code + PKCE) ────────────────
# Backend-only. Never put the client secret in frontend/VITE_* variables.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" of the Google OAuth web client.
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
# Where the browser lands after Google sign-in (errors add ?auth_error=<code>).
# GOOGLE_POST_LOGIN_URL=http://localhost:5173/

# ── Vision AI: provider selection ────────────────────────────────────────────
# local  = PRIMARY (default): in-process TorchXRayVision on this machine's NVIDIA GPU
#          (CPU fallback). No cloud settings required.
# cloud  = OPTIONAL: private Modal GPU worker. Must be selected explicitly; there is no
#          fallback in either direction, and an unavailable worker returns HTTP 503.
VISION_PROVIDER=local
# Load the local model at startup (recommended for demos).
# VISION_PRELOAD=1
# VISION_DEVICE=auto
# VISION_WEIGHTS_PATH=backend/models/weights/densenet121-res224-all.pt
# VISION_MAX_UPLOAD_BYTES=52428800
# VISION_MAX_OVERLAY_SIDE=1024
# VISION_RESULT_TTL_SECONDS=1800

# ── Vision AI: OPTIONAL cloud worker (only with VISION_PROVIDER=cloud) ────────
# Leave unset for local mode. Both are server-side values; never expose them to the frontend.
# VISION_CLOUD_URL=<server-side value: HTTPS URL of the deployed Modal worker>
# VISION_CLOUD_TOKEN=<server-side secret: equals the worker's VISION_WORKER_TOKEN>
# VISION_CLOUD_TIMEOUT_SECONDS=120
# The worker's own VISION_WORKER_TOKEN is provided by the Modal Secret
# "holomed-vision-worker" and is not set here.

# ── Text AI (explains structured vision output only; never sees images) ──────
# ollama    = PRIMARY (default): local Ollama for development/demo.
# omniroute = OPTIONAL hosted text AI (OpenAI-compatible gateway).
TEXT_AI_PROVIDER=ollama
# TEXT_AI_TIMEOUT_SECONDS=90
# Development (local Ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# OPTIONAL hosted text (TEXT_AI_PROVIDER=omniroute; base ending in /v1, HTTPS; secrets):
# OMNIROUTE_BASE_URL=
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=

# ── Bulk DICOM import (Imaging → Import: files, folder or ZIP) ────────────────
# Per import; every instance is also limited to 50 MiB. ZIPs are checked before extraction.
# HOLOMED_IMPORT_MAX_ARCHIVE_BYTES=2147483648
# HOLOMED_IMPORT_MAX_EXTRACTED_BYTES=4294967296
# HOLOMED_IMPORT_MAX_FILES=10000
# HOLOMED_IMPORT_MAX_COMPRESSION_RATIO=100
# HOLOMED_IMPORT_MAX_BATCH_FILES=100
# HOLOMED_IMPORT_JOB_TTL_SECONDS=3600

# ── Deployment tooling (read by deploy/modal/holomed_vision.py at deploy time) ─
# HOLOMED_MODAL_GPU=T4
# HOLOMED_MODAL_MIN_CONTAINERS=0
# HOLOMED_MODAL_SCALEDOWN_SECONDS=600

# ── Tests (optional) ─────────────────────────────────────────────────────────
# Run the live Ollama explanation test.
# HOLOMED_LIVE_OLLAMA=1
